{
  "name": "inbasekaran-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs tests/visual/*.test.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:legacy": "node scripts/verify-legacy.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "assets:generate": "node scripts/generate-assets.mjs",
    "digest:out": "node scripts/digest-out.mjs",
    "visual:smoke": "playwright test tests/visual/smoke.spec.ts tests/visual/no-js.spec.ts",
    "visual:capture:candidate": "playwright test tests/visual/capture.spec.ts",
    "visual:capture:verify": "VISUAL_RUN_ID=story-5-1-verify VISUAL_CAPTURE_COMMAND='npm run visual:capture:verify' playwright test tests/visual/capture.spec.ts",
    "verify:evidence-matrix": "VISUAL_RUN_ID=story-5-1-verify node scripts/verify-evidence-matrix.mjs",
    "verify:story-5-1": "npm run verify:runtime && npm run lint -- --max-warnings=0 && npm run typecheck && npm run build && npm run verify:content && npm run verify:legacy && npm run verify:assets && npm run digest:out && npm test && npm run visual:smoke && npm run visual:capture:verify && npm run verify:evidence-matrix",
    "visual:compare": "playwright test tests/visual/current-design.spec.ts",
    "visual:update": "playwright test tests/visual/current-design.spec.ts --update-snapshots",
    "verify:release": "npm run verify:runtime && npm run lint -- --max-warnings=0 && npm run typecheck && npm run build && npm run verify:content && npm run verify:assets && npm run verify:legacy && npm test && npm run visual:smoke && npm run visual:chapters && npm run visual:webkit && npm run visual:compare",
    "visual:chapters": "playwright test tests/visual/chapters.spec.ts tests/visual/annotation-followup.spec.ts",
    "visual:webkit": "playwright test --config=playwright.webkit.config.ts"
  },
  "dependencies": {
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "ajv": "^8.17.1",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.3",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}
